# Postgres (superuser — used only for running migrations/DDL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=his_db
DATABASE_URL=postgres://postgres:postgres_dev_password@postgres:5432/his_db

# Postgres (his_app role — least-privilege runtime connection, no DDL, cannot
# UPDATE/DELETE audit_log). Password here must match what migration 0001 creates
# the role with.
HIS_APP_DB_PASSWORD=his_app_dev_password
APP_DATABASE_URL=postgres://his_app:his_app_dev_password@postgres:5432/his_db

REDIS_URL=redis://redis:6379

# Auth
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

# AI (optional — every AI feature has a deterministic fallback if unset)
ANTHROPIC_API_KEY=

# HR — symmetric key for pgp_sym_encrypt/decrypt on staff_profiles.bank_details_enc
HR_ENCRYPTION_KEY=dev_hr_encryption_key_change_me

# Object storage (MinIO, S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=his-documents

# Email (Mailpit dev SMTP catcher — view sent mail at http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025

# ML service
ML_SERVICE_URL=http://ml-service:8000

PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# Host-side URL; the backend container's internal port is still 4000 — see
# docker-compose.yml's backend.ports mapping.
NEXT_PUBLIC_API_URL=http://localhost:4001
